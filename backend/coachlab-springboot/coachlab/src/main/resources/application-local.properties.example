# ── Perfil LOCAL (plantilla) ────────────────────────────────────────────────
# Copia este fichero quitándole ".example":
#     application-local.properties.example  ->  application-local.properties
# El fichero application-local.properties está en .gitignore: tus credenciales
# NO se subirán a git. Rellena los valores y arranca el backend con el perfil
# `local` (en IntelliJ: Run > Edit Configurations > Active profiles = local).

# --- Base de datos (Aiven MySQL) ---
spring.datasource.url=jdbc:mysql://TU_HOST.aivencloud.com:PUERTO/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
spring.datasource.username=avnadmin
spring.datasource.password=TU_PASSWORD_DE_AIVEN
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- Secretos ---
coachlab.fd.api-key=TU_NUEVA_API_KEY_DE_FOOTBALL_DATA
coachlab.jwt.secret=cadena-larga-de-al-menos-32-caracteres-para-desarrollo-local

# --- Crear los 3 usuarios de prueba al arrancar ---
coachlab.seed-demo=true
