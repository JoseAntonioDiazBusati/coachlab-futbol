# Local Docker Compose build — uses relative /api/ URLs so nginx can proxy to backend container.
# For Render production, use Dockerfile (builds with --configuration production).

# ── Stage 1: Build Angular (docker configuration) ────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .

# docker configuration uses environment.docker.ts → apiBase: '/api'
RUN npm run build -- --configuration docker

# ── Stage 2: nginx serving SPA + reverse proxy to backend container ───────────
FROM nginx:alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf

# Use the local nginx config which includes the reverse proxy block
COPY nginx.local.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist/coachlab-futbol/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
